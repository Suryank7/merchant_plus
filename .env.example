# ==============================================================================
# MerchantPulse AI — Environment Configuration
# ==============================================================================
# NOTE: The project is designed with 100% graceful fallbacks.
# It runs fully operational OUT OF THE BOX without requiring any external keys.
# Adding keys below enables live external API integrations.
# ==============================================================================

# === Razorpay Test Credentials (Optional) ===
# If left unset, uses built-in Razorpay test schemas and HMAC-SHA256 signature verifiers.
# Obtain test keys from: https://dashboard.razorpay.com/#/access-keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

# === Anthropic Claude 3.5 Sonnet (Optional) ===
# If left unset, executive CFO briefs are synthesized via the deterministic XAI engine.
# Obtain API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key

# === FastAPI ML Risk Engine URL ===
# Microservice running on port 8000 (uvicorn main:app --reload --port 8000)
NEXT_PUBLIC_RISK_ENGINE_URL=http://localhost:8000

# === Frontend Application URL ===
NEXT_PUBLIC_BASE_URL=http://localhost:3000
